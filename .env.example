# ---------------------------------------------------------------------------
# Climate Hazard Trend Analyzer - environment variables
#
# Backend:  copy the BACKEND block into  backend/.env
# Frontend: copy the FRONTEND block into frontend/.env  (only needed in production)
# Never commit real .env files. The MongoDB URI contains credentials.
# ---------------------------------------------------------------------------

# ============================ BACKEND (backend/.env) ========================

# development | production. Production disables /docs and refuses wildcard CORS.
APP_ENV=development

# MongoDB Atlas connection string (required for /api/analysis, /api/events, /api/export).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=climate_hazards
MONGODB_TIMEOUT_MS=5000

# Comma separated list of exact frontend origins. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reanalysis model used for every request: era5 (0.25 deg, from 1940) or era5_land (0.1 deg, from 1950).
OPEN_METEO_MODEL=era5
OPEN_METEO_TIMEOUT_SECONDS=30
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_BACKOFF_SECONDS=0.5
OPEN_METEO_MAX_BACKOFF_SECONDS=8
OPEN_METEO_CONCURRENCY=2
OPEN_METEO_CHUNK_YEARS=30
# Overall time budget for the upstream work of one analysis.
MAX_REQUEST_SECONDS=90

# Analysis bounds
MAX_YEAR_RANGE=90
BASELINE_START_YEAR=1991
BASELINE_END_YEAR=2020
MIN_BASELINE_COMPLETENESS=0.90
COORDINATE_PRECISION=2

ANALYSIS_CACHE_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=30
# Set to true only behind a trusted proxy that sets X-Forwarded-For (for example Render).
TRUST_PROXY_HEADERS=false

# =========================== FRONTEND (frontend/.env) =======================

# Leave empty for local development (Vite proxies /api to http://127.0.0.1:8000).
# In production set it to the backend origin, without a trailing slash.
VITE_API_BASE_URL=
